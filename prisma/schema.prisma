// Jadvix CRM — MongoDB (Atlas) schema.
//
// The spec's canonical model is implemented verbatim: every model, field,
// default, @@unique and @@index listed there is present and unchanged.
//
// It is then EXTENDED — additively, never by replacement — with the fields the
// existing frontend already drives, because the brief is "the exact frontend
// existing functionalities". Each extension block is marked FRONTEND-PARITY and
// says which frontend type it carries. Nothing in the canonical model was
// dropped, renamed or re-typed; enums only gained members.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/**
 * ----------------------------------------------------------------- enums --
 */

enum Role {
  developer
  sales
  qualityCheck
  manager
  superAdmin
  client
  vendor
  // FRONTEND-PARITY: EMPLOYEE_ROLES includes "Team Leader", which has no
  // canonical member. Projects treat teamLeader exactly like manager.
  teamLeader
}

enum EmpType {
  employee
  manager
  admin
}

enum CurrentStatus {
  idle
  workAssigned
  break
  leave
}

enum EmpStatus {
  fullTime
  partTime
  contractBased
}

enum EntityState {
  invited
  active
  disabled
}

enum ProjectState {
  planning
  active // frontend "On Track"
  onHold
  completed // frontend "Delivered"
  cancelled
  // FRONTEND-PARITY: PROJECT_STATUSES also has "At Risk" and "Delayed".
  atRisk
  delayed
}

enum MemberRole {
  manager
  member
}

enum MemberState {
  invited
  accepted
  declined
}

/**
 * The four board columns, plus one state the product does not offer.
 * Replaced todo/backlog/inProgress/inReview/done/blocked. The old values are
 * rewritten by scripts/migrate-task-states.ts — Prisma throws when it reads a
 * value that is not in this enum, so a row left behind takes the whole Tasks
 * module down rather than showing up in the wrong column.
 * `failed` is NOT a column and nothing in the UI can produce it. It is the
 * trigger for the spec's secondary KRA rule (README rule 44) and is kept
 * deliberately separate from `stuck`: dragging a card to Stuck says the work is
 * blocked, not that it failed review, and it must never cost anyone points.
 */
enum TaskState {
  notStarted
  working
  stuck
  done
  failed
}

enum Priority {
  low
  medium
  high
  urgent
}

// FRONTEND-PARITY: QcVerdict / MilestoneStatus / SecretEnv / TaskOrigin.kind.
enum QcVerdict {
  Approved
  Corrections
  Error
}

enum MilestoneStatus {
  planned
  inProgress
  done
  delayed
}

enum SecretEnv {
  local
  development
  staging
  production
}

enum BugSeverity {
  Critical
  Major
  Minor
}

/**
 * ------------------------------------------------------ composite types --
 */

type ChecklistItem {
  id    String
  label String
  done  Boolean @default(false)

  // FRONTEND-PARITY: ChecklistItem carries two independent numbers —
  //   score  0..1, how far along the line is (drives task completion)
  //   points what the line costs each assignee if QC rejects it
  // `done` stays authoritative for the canonical model and is kept in sync
  // with `score >= 1` by the task service.
  score  Float @default(0)
  points Int   @default(1)

  // Subtask metadata (a subtask is a richer checklist line, Monday-style).
  // DELIBERATELY has NO bearing on KRA: score + points above remain the only
  // inputs to the QC deduction. These are descriptive only, all optional so
  // every line saved before they existed still reads back cleanly.
  //   status uses the same TaskState enum as the parent task
  //   ownerId must be one of the parent task's assignees (enforced in service)
  //   priorityLevel is the frontend's 1..5
  description   String?
  status        TaskState?
  ownerId       String?    @db.ObjectId
  priorityLevel Int?
  startDate     DateTime?
  endDate       DateTime?
  createdBy     String?
  createdAt     DateTime?
  updatedBy     String?
  updatedAt     DateTime?
}

// FRONTEND-PARITY: Milestone — the client-facing delivery plan on a project.
type Milestone {
  id     String
  label  String
  due    DateTime
  status MilestoneStatus @default(planned)
  note   String?
}

// FRONTEND-PARITY: SecretEntry — project configuration vault.
// Values are stored as given; access is restricted server-side (never the
// client portal, never a plain member). Treat as low-sensitivity config only.
type SecretEntry {
  id        String
  key       String
  value     String
  env       SecretEnv
  note      String?
  updatedAt DateTime
  updatedBy String
}

// FRONTEND-PARITY: TaskUpdate — append-only audit trail line on a task.
type TaskUpdateEntry {
  id      String
  at      DateTime
  by      String
  summary String
}

// FRONTEND-PARITY: QcReview.affected — KRA move per person, frozen at review time.
type QcAffected {
  userId String
  from   Int
  to     Int
}

// FRONTEND-PARITY: QcReview — append-only QC history on a task. An Error
// verdict is what deducts KRA; see modules/tasks/qc.service.ts.
type QcReview {
  id             String
  at             DateTime
  by             String
  byUserId       String?
  verdict        QcVerdict
  note           String?
  failedItemIds  String[]
  pointsDeducted Int          @default(0)
  affected       QcAffected[]
}

// FRONTEND-PARITY: TaskOrigin — a defect raised in Proposed Bugs becomes a task.
type TaskOrigin {
  kind           String // "qc-bug"
  severity       BugSeverity
  raisedBy       String
  raisedByUserId String?
  foundIn        String?
}

// FRONTEND-PARITY: WorkspaceSettings — per-company workspace preferences.
type WorkspaceSettings {
  autoEmployeeId Boolean @default(true)
  defaultBranch  String?

  /**
   * Does putting someone on a project need their say-so?
   * True (the default, and the behaviour that predates this field) means a new
   * ProjectMember starts `invited` and the person accepts it in Requests.
   * False means they are placed on the project immediately as `accepted` and
   * simply told about it. A project can override this for itself — see
   * Project.requireAcceptance.
   */
  requireProjectAcceptance Boolean @default(true)
}

/**
 * ---------------------------------------------------------------- models --
 */

model Company {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  companyName     String
  companyAddress  String
  linkedinProfile String?
  companyWebsite  String
  about           String
  ownerName       String
  email           String      @unique
  headBranch      String
  state           EntityState @default(invited) // active once owner sets password
  users           User[]
  branches        Branch[]
  projects        Project[]
  tasks           Task[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // FRONTEND-PARITY: WorkspacePrefs (auto employee IDs, pinned default branch).
  settings      WorkspaceSettings?
  notifications Notification[]
  clients       Client[]
  teams         Team[]
  sprints       Sprint[]
  shifts        Shift[]
  dailyReports  DailyReport[]
}

model Branch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isHead    Boolean  @default(false)
  users     User[]
  createdAt DateTime @default(now())

  // Where the office is, and what it trades in.
  //
  // `currency` is DERIVED from `country` by lib/countries.ts on every write and
  // is never taken from the request — a client that could name both could pair
  // a country with the wrong currency and quietly corrupt every figure reported
  // against the branch. Nullable because branches created before these existed
  // have none, and a branch with no country has no currency to invent.
  city     String?
  country  String? // ISO 3166-1 alpha-2
  currency String? // ISO 4217, derived from `country`

  @@index([companyId])
}

model User {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String          @db.ObjectId
  company         Company         @relation(fields: [companyId], references: [id])
  name            String
  email           String
  empId           String          @unique // auto-generated, editable
  passwordHash    String?
  roles           Role[]
  empType         EmpType         @default(employee)
  empStatus       EmpStatus       @default(fullTime)
  currentStatus   CurrentStatus   @default(idle)
  branchId        String?         @db.ObjectId
  branch          Branch?         @relation(fields: [branchId], references: [id])
  kra             Int             @default(100)
  openWork        Int             @default(0)
  isOwner         Boolean         @default(false)
  state           EntityState     @default(invited)
  moduleAccess    String[]
  reportsToId     String?         @db.ObjectId
  reportsTo       User?           @relation("Reports", fields: [reportsToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports         User[]          @relation("Reports")
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  resetTokenHash  String?
  resetExpiresAt  DateTime?
  memberships     ProjectMember[]
  createdProjects Project[]       @relation("ProjectCreatedBy")
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreatedBy")
  kraEvents       KraEvent[]
  refreshTokens   RefreshToken[]
  shifts          Shift[]         @relation("ShiftUser")
  // The daily work report, NOT the reporting line above — `reports` is already
  // taken by the people who report to this user.
  dailyReports    DailyReport[]   @relation("DailyReportUser")
  ratedReports    DailyReport[]   @relation("DailyReportRater")
  joinedAt        DateTime        @default(now()) // = createdAt
  updatedAt       DateTime        @updatedAt

  // FRONTEND-PARITY: Employee.phone / Employee.tone (avatar colour).
  phone String?
  tone  String  @default("blue")

  /// Profile picture, as a compressed data URL.
  ///
  /// On the row rather than in the attachment store on purpose: an avatar is
  /// tiny (the client squares and compresses it before sending), it is read on
  /// every screen that shows a person, and keeping it here means no second
  /// request and no signed-URL dance just to draw a face.
  avatar String?

  /// The Slack-style status: a short line, an emoji, and when it lapses.
  ///
  /// An expired `statusUntil` is treated as "no status" by every reader rather
  /// than being cleared by a job — so a lapsed status costs nothing and no
  /// scheduler has to exist for this to be correct.
  statusText  String?
  statusEmoji String?
  statusUntil DateTime?

  /// Presence. `lastSeenAt` is stamped by a heartbeat from the open app and
  /// "online" is DERIVED from it being recent, so a crashed tab or a shut
  /// laptop goes offline on its own instead of leaving a green dot behind.
  /// `presence` is the manual override: "auto" or "away".
  presence   String    @default("auto")
  lastSeenAt DateTime?

  // Login throttling — a per-account lockout that survives a restart, because
  // the API is stateless and must not keep counters in instance memory.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  notifications Notification[] @relation("NotificationTo")

  @@unique([companyId, email])
  @@index([companyId])
  @@index([reportsToId])
}

model Project {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String          @db.ObjectId
  company     Company         @relation(fields: [companyId], references: [id])
  name        String
  description String?
  state       ProjectState    @default(planning)
  createdById String          @db.ObjectId
  createdBy   User            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members     ProjectMember[]
  tasks       Task[]
  progress    Int             @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // FRONTEND-PARITY: Project.code / client / clientId / problemStatement /
  // solution / plan / secrets. `clientId` points at the CRM's own client list,
  // which still lives in the frontend mock store, so it is a plain string.
  code             String?
  client           String?
  clientId         String?
  problemStatement String?
  solution         String?
  plan             Milestone[]
  secrets          SecretEntry[]

  /**
   * Teams assigned to this project.
   * A reference, kept for display and traceability. It is NOT the membership:
   * assigning a team expands its people into ProjectMember rows, so every
   * downstream rule (acceptance, who may be given a task, who sees it) keeps
   * working off the one list it always has. Removing a team later therefore
   * does not silently remove the people it brought.
   */
  teamIds String[] @db.ObjectId

  /**
   * Overrides WorkspaceSettings.requireProjectAcceptance for this project.
   * Null means "follow the workspace default", which is why it is nullable
   * rather than a plain boolean with a default.
   */
  requireAcceptance Boolean?

  /// The project's own sprints. Many per project — see the Sprint model.
  sprints Sprint[]

  @@index([companyId])
}

model ProjectMember {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String      @db.ObjectId
  project     Project     @relation(fields: [projectId], references: [id])
  userId      String      @db.ObjectId
  user        User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role        MemberRole // manager (team lead) or member
  state       MemberState @default(invited) // must accept to become active
  invitedById String      @db.ObjectId
  invitedAt   DateTime    @default(now())
  respondedAt DateTime?

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String          @db.ObjectId
  company     Company         @relation(fields: [companyId], references: [id])
  projectId   String          @db.ObjectId
  project     Project         @relation(fields: [projectId], references: [id])
  title       String
  description String?
  assigneeId  String?         @db.ObjectId
  assignee    User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String          @db.ObjectId
  createdBy   User            @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  state       TaskState       @default(notStarted)
  priority    Priority        @default(medium)
  kraPoints   Int             @default(0) // points at stake
  kraApplied  Boolean         @default(false) // guard against double-deduction
  checklist   ChecklistItem[]
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // FRONTEND-PARITY. A frontend task serves several projects and several
  // assignees, so the canonical single-valued `projectId` / `assigneeId` are
  // kept as the PRIMARY of each list and the full lists live alongside.
  // The service keeps projectId === projectIds[0] and assigneeId === assigneeIds[0].
  projectIds  String[] @db.ObjectId
  assigneeIds String[] @db.ObjectId
  reportToIds String[] @db.ObjectId
  /**
   * Teams assigned to this task. As on Project: a reference for display, with
   * the people expanded into `assigneeIds` so the task rules are unchanged.
   */
  teamIds     String[] @db.ObjectId

  /// Manual sort position, for dragging rows in the grid view.
  ///
  /// A Float, not an Int, on purpose: dropping a row between two others sets it
  /// to the MIDPOINT of its neighbours, so one row moves and nothing else is
  /// rewritten. An Int would force renumbering the whole group on every drop.
  order Float @default(0)

  /// The sprint this task sits in, or null for the backlog.
  ///
  /// Nullable on purpose: a project's first task exists before its first
  /// sprint does, and work that has not been planned into one still has to be
  /// filed somewhere. The service enforces that the sprint belongs to one of
  /// the task's own projects.
  sprintId      String?           @db.ObjectId
  sprint        Sprint?           @relation(fields: [sprintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taskCode      String? // human-facing "TSK-001"
  // 1..5, the frontend's P1–P5. `priority` above stays the canonical field and
  // is derived from this: 1 urgent, 2 high, 3 medium, 4-5 low.
  priorityLevel Int               @default(3)
  startDate     DateTime?
  endDate       DateTime?
  prUrl         String?
  origin        TaskOrigin?
  updates       TaskUpdateEntry[]
  qcReviews     QcReview[]
  attachments   TaskAttachment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([companyId])
  @@index([companyId, state])
  // The sprint board reads every lane's task count on each render, and both
  // the grouped counts and the "release this sprint's tasks" update filter on
  // sprintId. Without this each one is a collection scan.
  @@index([companyId, sprintId])
}

/**
 * A file attached to a task.
 * The bytes are NOT here — only a pointer to them. `provider` names the driver
 * holding them and `storageKey` is that driver's handle — a path key on disk, a
 * fileId in ImageKit. Both are generated by the server (random, no extension
 * taken from the request) and are the only name the filesystem or bucket ever
 * sees; `fileName` is what the uploader called it, stored purely so the
 * download can be given a sensible name and never used to build a path.
 * `companyId` is denormalised off the task on purpose. Every read filters on it
 * first, so a mis-typed task id can never reach across tenants even if the task
 * lookup were somehow skipped.
 */
model TaskAttachment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId       String   @db.ObjectId
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  companyId    String   @db.ObjectId
  // When set, this file belongs to one subtask (embedded checklist line id)
  // rather than the task as a whole. Task-level files leave it null, so the
  // existing per-task query (`subtaskId: null`) is unchanged.
  subtaskId    String?
  fileName     String
  mimeType     String
  size         Int
  // Which driver holds the bytes. Decided per row at upload time, NOT read from
  // the current configuration: turning ImageKit on must leave every file
  // already on disk downloadable and deletable through the local driver.
  provider     String   @default("local")
  storageKey   String   @unique
  // The object's canonical URL in ImageKit, which delivery URLs are signed
  // from. Null for local rows, which have no URL — their bytes are streamed by
  // the download route itself. Never returned to a client unsigned: the file is
  // uploaded private, so an unsigned URL would 401 anyway.
  url          String?
  uploadedById String   @db.ObjectId
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([companyId])
  @@index([taskId, subtaskId])
}

model KraEvent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taskId       String?  @db.ObjectId
  delta        Int // negative = deduction
  reason       String
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([companyId])
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// The master's refresh sessions.
///
/// Separate from RefreshToken because that model's `userId` is a required
/// relation to User and the master has no User row — it authenticates against
/// MASTER_PASSWORD_HASH. Without this the master had no refresh token at all,
/// so a browser reload lost the session outright: the access token lives in
/// memory by design and there was nothing to restore it from.
model MasterSession {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// FRONTEND-PARITY: Client — an account the company delivers for.
// Projects reference it by id, which is how a project gets a real client rather
// than a free-text name.
model Client {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  companyId String       @db.ObjectId
  company   Company      @relation(fields: [companyId], references: [id])
  code      String // human-facing, e.g. CL-01
  name      String
  contact   String
  email     String
  phone     String?
  industry  String?
  /// Lifetime value, stored as a number so it can be summed.
  value     Int          @default(0)
  since     String?
  status    ClientStatus @default(onboarding)
  notes     String?
  tone      String       @default("blue")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

enum ClientStatus {
  active
  onboarding
  dormant
}

// FRONTEND-PARITY: Notification — one row per recipient, never broadcast.
// Emitted by the task and project flows so nothing the frontend used to raise
// in localStorage is lost once those modules talk to the API.
model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  company   Company  @relation(fields: [companyId], references: [id])
  toUserId  String   @db.ObjectId
  to        User     @relation("NotificationTo", fields: [toUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind      String
  title     String
  detail    String
  read      Boolean  @default(false)
  taskId    String?  @db.ObjectId
  projectId String?  @db.ObjectId
  createdAt DateTime @default(now())

  @@index([toUserId, read])
  @@index([companyId])
}

/**
 * A named set of people.
 * Teams exist so "the platform squad" can be put on a project or a task in one
 * action instead of ticking eight names. They are a CONVENIENCE OVER
 * MEMBERSHIP, not a replacement for it: assigning a team expands its people
 * into ProjectMember rows / Task.assigneeIds at the moment of assignment, and
 * everything downstream keeps reading those. Two consequences worth knowing:
 * - Adding someone to a team does not retro-add them to projects the team is
 * already on. That would silently grant access to work nobody reviewed.
 * - Removing a team from a project does not remove the people it brought.
 * They were individually placed, and may since have been given tasks.
 * `memberIds` is a plain id list rather than a join model: a team is small,
 * always read whole, and has no per-membership state to carry.
 */
model Team {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @db.ObjectId
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  /**
   * Avatar colour, same vocabulary as User.tone.
   */
  tone        String   @default("blue")
  /**
   * Optional lead. Must be one of `memberIds`; enforced in the service.
   */
  leadId      String?  @db.ObjectId
  memberIds   String[] @db.ObjectId
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // One name per company, so "Platform" is unambiguous in a picker.
  @@unique([companyId, name])
  @@index([companyId])
}

/**
 * ---------------------------------------------------------------- sprints --
 */

enum SprintState {
  planned
  active
  completed
  cancelled
}

/**
 * A sprint: one slice of a project's work, with a window and a goal.
 * Scoped to a PROJECT rather than to the company, because that is how the
 * board reads: a project has many sprints, a sprint belongs to exactly one
 * project, and a task sits in at most one sprint of its own project. Tasks
 * outside every sprint are legal and land in the board's "Backlog" lane —
 * requiring a sprint would have made the first task of a new project
 * impossible to file.
 * `order` is a Float for the same reason Task.order is: dropping a sprint
 * between two others takes the midpoint and rewrites one row.
 */
model Sprint {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String      @db.ObjectId
  company     Company     @relation(fields: [companyId], references: [id])
  projectId   String      @db.ObjectId
  project     Project     @relation(fields: [projectId], references: [id])
  name        String
  /// What this sprint is FOR, in one line. Shown under the lane heading.
  goal        String?
  state       SprintState @default(planned)
  /// Lane colour, same vocabulary as User.tone and Team.tone.
  tone        String      @default("violet")
  startDate   DateTime?
  endDate     DateTime?
  order       Float       @default(0)
  createdById String      @db.ObjectId
  tasks       Task[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // One sprint name per project — "Sprint 1" in two projects is fine, twice in
  // one project is a mistake someone would stare at for a while.
  @@unique([projectId, name])
  @@index([companyId])
  @@index([projectId])
}

/**
 * ---------------------------------------------------------- daily reports --
 */

/**
 * What one person did on one day, and what a super admin thought of it.
 *
 * One row per person per day, enforced by the unique index: a day is a thing
 * you revise, not a thing you file twice, so the write path is an upsert and
 * the history stays one entry per date.
 *
 * The rating lives on the same row rather than in a table of its own. A star
 * is a property of the day's report ("how was Tuesday"), it is given at most
 * once, and keeping it here means no join to draw the only two views anyone
 * asks for: an employee's own run of days, and a super admin's grid of
 * everyone's.
 */
model DailyReport {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId String    @db.ObjectId
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String    @db.ObjectId
  user      User      @relation("DailyReportUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// The author's local calendar day, YYYY-MM-DD — same convention as Shift.
  date      String
  /// What they did. Rich text, sanitised on the way in.
  body      String
  /// Optional one-line summary, for the super admin's grid.
  headline  String?
  /// 1-5, or null until a super admin has looked at it.
  stars     Int?
  /// Who rated it. Kept so a disputed star has a name against it.
  ratedById String?   @db.ObjectId
  ratedBy   User?     @relation("DailyReportRater", fields: [ratedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ratedAt   DateTime?
  /// What the super admin said alongside the stars.
  feedback  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // One report per person per day. The upsert in the service depends on this,
  // and it doubles as the index for an employee's own run of days.
  @@unique([userId, date])
  // The super admin's grid: every report for one day.
  @@index([companyId, date])
}

/**
 * ------------------------------------------------------------- attendance --
 */

/**
 * One shift. Clock in, optional breaks, clock out.
 * Open shift == `outAt` is null, and that is the ONLY definition of "clocked
 * in" anywhere in the product. A stored boolean would have to be kept in step
 * with the row and would drift the first time a process died mid-write.
 * `date` is the local calendar day as `YYYY-MM-DD`, stored as a string rather
 * than derived from `inAt`: a shift that starts at 23:40 belongs to the day the
 * person says they started, not to whichever day UTC thinks it is.
 */
model Shift {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String    @db.ObjectId
  company      Company   @relation(fields: [companyId], references: [id])
  userId       String    @db.ObjectId
  user         User      @relation("ShiftUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date         String
  inAt         DateTime
  outAt        DateTime?
  /// Total minutes on break across the shift, accumulated as breaks end.
  breakMinutes Int       @default(0)
  /// When the current break started, or null when not on one.
  breakAt      DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId, date])
  @@index([userId, date])
  // The open-shift lookup, which runs on every clock action and every roster
  // read. Without it that is a collection scan per request.
  @@index([companyId, outAt])
}
