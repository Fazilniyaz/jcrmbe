# Copy to .env and fill in. NEVER commit the filled-in file.

# MongoDB Atlas SRV connection string, e.g.
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/jadvix?retryWrites=true&w=majority
DATABASE_URL=

# Two DIFFERENT long random strings (32+ chars each).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Master (platform owner) login. The password is never stored — only its argon2 hash.
# Generate the hash with: npm run hash-master
MASTER_EMAIL=jadvixltd@gmail.com
MASTER_PASSWORD_HASH=

# Frontend origin, used to build invite links.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Comma-separated list is allowed for multiple frontends.
CORS_ORIGIN=http://localhost:3000

# Gmail SMTP. GMAIL_APP_PASSWORD is a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# Left empty, the mailer logs the invite link instead of sending it.
GMAIL_USER=jadvixltd@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM=Jadvix <jadvixltd@gmail.com>

# Optional
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Set to 1 only behind a trusted reverse proxy (rate limiting reads X-Forwarded-For).
TRUST_PROXY=0
