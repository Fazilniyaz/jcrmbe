# Copy to .env and fill in. NEVER commit the filled-in file.

# MongoDB Atlas SRV connection string, e.g.
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/jadvix?retryWrites=true&w=majority
DATABASE_URL=

# Two DIFFERENT long random strings (32+ chars each).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Master (platform owner) login. The password is never stored — only its argon2 hash.
# Generate the hash with: npm run hash-master
MASTER_EMAIL=jadvixltd@gmail.com
MASTER_PASSWORD_HASH=

# Frontend origin, used to build invite links.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Comma-separated list is allowed for multiple frontends.
CORS_ORIGIN=http://localhost:3000

# Gmail SMTP. GMAIL_APP_PASSWORD is a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# Left empty, the mailer logs the invite link instead of sending it.
#
# MAIL_FROM is DERIVED from GMAIL_USER when left empty. Gmail only sends as the
# authenticated account or a verified "Send mail as" alias, so set it only for
# such an alias.
GMAIL_USER=jadvixltd@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM=

# Optional
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Set to 1 only behind a trusted reverse proxy (rate limiting reads X-Forwarded-For).
TRUST_PROXY=0

# Task attachments. UPLOAD_DIR must be a directory the process can write to and
# is NOT under the app — files land there under a server-generated random key.
UPLOAD_DIR=./var/uploads
UPLOAD_MAX_BYTES=10485760

# Encrypts the per-project secrets vault at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Left empty, vault values are stored as plaintext exactly as before and the API
# warns at startup. Setting it is safe at any time: existing plaintext rows keep
# working and re-encrypt as they are next saved.
#
# KEEP THIS KEY. Losing or rotating it does NOT re-encrypt stored values — they
# stop decrypting and read as empty until someone re-saves them.
SECRETS_KEY=

# ImageKit.io — where attachments actually live once these are filled in.
# Leave them empty and uploads fall back to UPLOAD_DIR on local disk, which is
# the right setup for local development.
#
# IMAGEKIT_PRIVATE_KEY IS A SECRET. It only ever lives in this file and in the
# API process: the browser uploads to this API, never to ImageKit directly.
# Values come from the ImageKit dashboard > Developer options > API keys.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Root folder every company's files are nested under (/<folder>/<companyId>/<taskId>).
IMAGEKIT_FOLDER=/jadvix
