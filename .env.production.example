# Copy to `.env.production` ON THE SERVER and fill in. Never commit the filled file.
# Replace <ELASTIC_IP> with your Elastic IP (dots kept).
#
# Every value below is a PLACEHOLDER. This file is committed, so nothing real
# belongs in it — not a connection string, not a key, not a password hash. If
# you need a reminder of what a filled-in file looks like, look at the server.

# MongoDB Atlas SRV string.
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/jadvix?retryWrites=true&w=majority

# Two DIFFERENT random strings, 48+ bytes each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-48-random-bytes-base64url
JWT_REFRESH_SECRET=replace-me-different-48-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# The platform owner. The password itself is never stored, only its argon2
# hash — generate it with: npm run hash-master
MASTER_EMAIL=owner@example.com
MASTER_PASSWORD_HASH=

# All the same public origin — frontend, API and invite links share one host.
APP_URL=https://<ELASTIC_IP>.sslip.io
API_URL=https://<ELASTIC_IP>.sslip.io
CORS_ORIGIN=https://<ELASTIC_IP>.sslip.io

# Gmail SMTP. GMAIL_APP_PASSWORD is a 16-character App Password, NOT the
# account password (Google Account > Security > 2-Step Verification > App
# passwords). Left empty, the mailer logs invite links instead of sending them.
#
# MAIL_FROM is DERIVED from GMAIL_USER when left empty, which is the right
# setting for almost everyone: Gmail only sends as the authenticated account or
# one of its verified "Send mail as" aliases, and rewrites or refuses anything
# else. Set it only to use such an alias.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

PORT=4000
NODE_ENV=production
LOG_LEVEL=info
# REQUIRED in this topology: Caddy sits in front, and rate limiting reads
# X-Forwarded-For. Leave it 0 anywhere there is no trusted proxy.
TRUST_PROXY=1

# Encrypts the per-project secrets vault at rest (AES-256-GCM). See
# src/lib/secretBox.ts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Left empty, vault values are stored as plaintext and the API warns at
# startup. KEEP THIS KEY: rotating it does not re-encrypt stored values.
SECRETS_KEY=

# Task attachments. Inside the container this must be the mount point of the
# `uploads` volume in docker-compose.yml, or every redeploy loses the files.
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=10485760

# ImageKit.io. Filled in, attachments go to the object store and UPLOAD_DIR is
# only read for files uploaded before the switch — keep the volume mounted.
# IMAGEKIT_PRIVATE_KEY is a SECRET: server-side only, never exposed to the app.
# Values come from the ImageKit dashboard > Developer options > API keys.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/jadvix
